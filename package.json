{
  "name": "@aaakul/astro-plain",
  "version": "1.1.0",
  "type": "module",
  "private": true,
  "overrides": {
    "@types/hast": "^3.0.5"
  },
  "scripts": {
    "dev": "astro sync && astro dev --host --open",
    "build": "astro build",
    "preview": "astro preview --host --open",
    "astro": "astro",
    "check": "astro check && prettier --check .",
    "sync": "astro sync",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "node -e \"process.env.CI && process.exit(0); process.exit(1)\" || husky"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs,astro,json,css,scss,md,mdx,html,yaml,yml}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@aaakul/ts-intl": "^1.0.0",
    "@astrojs/markdown-remark": "^7.2.4",
    "@astrojs/mdx": "^8.0.1",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@expressive-code/core": "^0.44.2",
    "@expressive-code/plugin-collapsible-sections": "^0.44.2",
    "@expressive-code/plugin-line-numbers": "^0.44.2",
    "astro": "^7.3.1",
    "astro-expressive-code": "^0.44.2",
    "astro-loading-indicator": "^0.9.0",
    "astro-pagefind": "^2.0.1",
    "github-slugger": "^2.0.0",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/hast": "^3.0.5",
    "hast-util-from-html": "^2.0.3",
    "hast-util-select": "^6.0.4",
    "hast-util-to-string": "^3.0.1",
    "hastscript": "^9.0.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.0",
    "mdast-util-to-string": "^4.0.0",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "reading-time": "^1.5.0",
    "rehype": "^13.0.2",
    "rehype-format": "^5.0.1",
    "remark-github-blockquote-alert": "^2.1.0",
    "typescript": "^5.9.3",
    "unist-util-visit": "^5.1.0",
    "vfile": "^6.0.3"
  }
}
