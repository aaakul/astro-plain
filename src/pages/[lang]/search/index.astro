---
import Topic from "@/components/blog/Topic.astro";
import RootLayout from "@/layouts/RootLayout.astro";
import { AVAILABLE_LANG, useTranslations } from "~/i18n";
import { getStats } from "~/lib/content-utils";
import Search from "@/components/Search.astro";

export async function getStaticPaths() {
  return AVAILABLE_LANG.map((lang) => ({
    params: { lang: lang },
  }));
}

const { lang } = Astro.params;

const t = useTranslations("common");

// Retrieve tag and category frequency statistics for quick filter links
const tagStats = await getStats(lang, "tags");
const tagText = !tagStats ? null : Object.keys(tagStats);

const categoryStats = await getStats(lang, "categories");
const categoryText = !categoryStats ? null : Object.keys(categoryStats);
---

<RootLayout>
  <main slot="content">
    <h1 class="sr-only">{t("search")}</h1>

    <Search id="search" />

    {
      categoryStats && (
        <section class="section">
          <h2>{t("categories")}</h2>
          <ul class="topics-container">
            {categoryText!.map((category) => (
              <li class="topic-item">
                <Topic text={category} type="categories" />
                <span class="count">({categoryStats[category as keyof typeof categoryStats]})</span>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <hr />

    {
      tagStats && (
        <section class="section">
          <h2>{t("tags")}</h2>
          <ul class="topics-container">
            {tagText!.map((tag) => (
              <li class="topic-item">
                <Topic text={tag} />
                <span class="count">({tagStats[tag as keyof typeof tagStats]})</span>
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </main>
</RootLayout>

<style>
  main {
    display: flex;
    flex-direction: column;
    row-gap: var(--space-6);
  }

  #search {
    margin-bottom: var(--space-4);
  }

  .section {
    display: flex;
    flex-direction: column;
  }

  h2 {
    font-size: var(--font-size-2xl);
    margin-bottom: var(--space-4);
  }

  .topics-container {
    display: flex;
    flex-wrap: wrap;
    column-gap: var(--space-4);
    row-gap: var(--space-2);
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .topic-item {
    display: inline-flex;
    align-items: center;
    font-weight: var(--font-weight-normal);
    font-size: var(--font-size-lg);
    margin: 0;
  }

  .count {
    font-size: var(--font-size-lg);
    color: var(--muted-foreground);
    margin-left: var(--space-1);
  }

  hr {
    margin-block: var(--space-1);
  }
</style>
