---
import { useTranslations } from "~/i18n";
import Icon from "@/components/ui/Icon.astro";

const t = useTranslations("theme_switcher");

const themeModeMap = {
  dark: t("dark"),
  light: t("light"),
  system: t("system"),
};

type ThemeMode = keyof typeof themeModeMap;

const themeModeKey = Object.keys(themeModeMap) as readonly ThemeMode[];
---

<script>
  import { PopupMenu } from "./PopupMenu";

  // Dropdown component managing light/dark/system theme switching
  class ThemeSwitcher extends PopupMenu {
    private readonly storageKey: string = "THEME";
    private readonly rootElement: HTMLElement = document.documentElement;
    private readonly attrName: Record<string, string> = {
      global: "data-color-scheme",
      code: "data-theme",
    };
    private readonly codeLightTheme =
      document.documentElement.dataset.codeThemeLight ?? "github-light";
    private readonly codeDarkTheme =
      document.documentElement.dataset.codeThemeDark ?? "github-dark";

    handleClick(e: Event) {
      const theme = (e.currentTarget as HTMLButtonElement).dataset.theme;

      if (theme === "dark" || theme === "light") {
        // Set root HTML attributes for global UI and expressive-code syntax highlighting
        this.rootElement.setAttribute(this.attrName.global, theme);

        this.rootElement.setAttribute(
          this.attrName.code,
          theme === "light" ? this.codeLightTheme : this.codeDarkTheme,
        );

        localStorage.setItem(this.storageKey, theme);
      } else if (theme === "system") {
        // Remove overrides so CSS prefers-color-scheme media queries take effect
        this.rootElement.removeAttribute(this.attrName.global);
        this.rootElement.removeAttribute(this.attrName.code);

        localStorage.removeItem(this.storageKey);
      }

      this.syncActiveUI();
      this.hideMenu();
    }

    // Sync aria-pressed state on dropdown buttons with current theme
    syncActiveUI() {
      const current = localStorage.getItem(this.storageKey) || "system";

      this.optionsButton?.forEach((opt: HTMLElement) => {
        const btn = opt as HTMLButtonElement;
        const isActive = btn.dataset.theme === current;
        btn.setAttribute("aria-pressed", isActive ? "true" : "false");
      });
    }
  }

  if (!customElements.get("theme-switcher")) {
    customElements.define("theme-switcher", ThemeSwitcher);
  }
</script>

<theme-switcher>
  <button
    aria-expanded="false"
    aria-controls="theme-panel"
    aria-label={t("toggle_theme")}
    type="button"
    part="button"
    title={t("toggle_theme")}
  >
    <Icon name="contrast" size="1.5rem" />
  </button>
  <div id="theme-panel" class="popup-panel border-shadow hidden fadeIn">
    {
      themeModeKey.map((option: ThemeMode) => (
        <button type="button" class="popup-item" data-theme={option} value={option}>
          {themeModeMap[option as ThemeMode]}
        </button>
      ))
    }
  </div>
</theme-switcher>
