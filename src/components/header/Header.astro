---
import SiteConfig from "~/site.config";
import HeaderLink from "./HeaderLink.astro";
import HeaderButton from "./HeaderButton.astro";
import { useTranslations, useLocale, type Lang } from "~/i18n";
import Link from "@/components/ui/Link.astro";

type Props = { switchLinks: Map<Lang, string> };

const { switchLinks } = Astro.props;
const lang = useLocale();

const t = useTranslations("common");

const defaultNavLinks = [
  { href: "", titleKey: "home" },
  { href: "/projects", titleKey: "projects" },
  { href: "/about", titleKey: "about" },
  { href: "/search", titleKey: "search" },
];

const navConfig = SiteConfig.navLinks ?? defaultNavLinks;
const links = navConfig.map((item) => {
  const { href, titleKey, ...restItem } = item;
  return {
    href,
    title: t(titleKey as any) || titleKey,
    ...restItem,
  };
});
---

{
  /* Sticky header navbar with 3-column grid layout (start: logo, center: nav links, end: actions) */
}
<nav aria-label={t("global_nav")} class="border-shadow" id="header-nav">
  <div id="container">
    <div id="nav-start">
      <Link
        id="logo-title"
        href={`/${lang}`}
        aria-label={t("link_to", { title: t("home") })}
        title={t("home")}
      >
        {
          SiteConfig.isShowLogo && (
            <img src={SiteConfig.basePath + "/favicon.svg"} alt="Logo" width={32} height={32} />
          )
        }
        <div id="site-title" class="hidden">
          {t("header_title")}
        </div>
      </Link>
    </div>

    <div id="nav-center" class="hidden fadeIn">
      <HeaderLink links={links} />
    </div>

    <div id="nav-end">
      <HeaderButton switchLinks={switchLinks} />
    </div>
  </div>
</nav>

<style>
  nav,
  #background {
    z-index: 10;
    width: 100%;

    position: sticky;
    top: 0;

    background-color: var(--background);

    border-top: none;
    border-left: none;
    border-right: none;
  }

  #container {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;

    margin-inline: auto;
    padding-inline: var(--space-4);

    height: var(--header-nav-height);

    max-width: var(--content-max-width);
    width: 100%;
    box-sizing: border-box;
  }

  #nav-start,
  #nav-end {
    display: flex;
    text-align: center;
    margin-block: auto;
  }

  #nav-start {
    grid-column: 1;
    justify-self: start;
  }

  #nav-end {
    grid-column: 3;
    justify-self: end;
    position: relative;
    z-index: 1000;
    height: 100%;
    align-items: center;
  }

  #logo-title {
    display: flex;
    align-items: center;
    column-gap: var(--space-2);
  }

  @media screen and (min-width: 1024px) {
    #nav-center {
      display: flex;
      justify-self: center;
      grid-column: 2;
      align-items: center;
      column-gap: var(--space-8);
      word-break: keep-all;
    }

    #nav-center :global(a) {
      color: var(--muted-foreground);
      font-weight: var(--font-weight-medium);
      transition: color var(--duration) ease;
    }

    #nav-center :global(a:hover) {
      color: var(--primary);
    }

    #nav-center :global(a[aria-current="page"]) {
      color: var(--foreground);
      font-weight: var(--font-weight-semi-bold);
    }

    #site-title {
      display: block;
      color: var(--primary);
      font-weight: var(--font-weight-semi-bold);
      text-overflow: ellipsis;
      white-space: nowrap;
    }
  }

  @media screen and (min-width: 1280px) {
    #nav-center,
    #site-title {
      font-size: var(--font-size-lg);
    }
  }

  @media screen and (max-width: 1023px) {
    .show-mobile-nav {
      display: flex;
      flex-direction: column;

      position: fixed;

      top: 0;
      left: 0;

      width: 100%;
      height: 100%;
      height: 100dvh;
      max-height: 100vh;
      max-height: 100dvh;
      overflow-y: auto;
      -webkit-overflow-scrolling: touch;

      z-index: 999;

      background-color: var(--accent);

      box-sizing: border-box;

      padding-inline: var(--space-8);

      font-size: var(--font-size-2xl);

      row-gap: var(--space-6);

      padding-top: var(--header-nav-height);
    }

    .show-mobile-nav :global(a) {
      color: var(--muted-foreground);
      transition: color var(--duration) ease;
    }

    .show-mobile-nav :global(a:hover) {
      color: var(--foreground);
    }

    .show-mobile-nav :global(a[aria-current="page"]) {
      color: var(--primary) !important;
      font-weight: var(--font-weight-bold) !important;
    }
  }
</style>
