---
import { getTranslations, type Lang } from "~/i18n";
import Link from "@/components/ui/Link.astro";
import type { HTMLAttributes } from "astro/types";

export type LinkItem = {
  title: string;
  href: string;
  "aria-label"?: string;
} & HTMLAttributes<"a">;

type Props = {
  links: LinkItem[];
  class?: string;
  lang: Lang;
};

const { links, class: className, lang } = Astro.props;
const t = getTranslations(lang, "common");

// Strip trailing slash for consistent pathname matching
const currentPath = Astro.url.pathname;
const normalize = (p: string) => p.replace(/\/$/, "") || "/";
---

{
  links.map((link) => {
    const { href, title, class: itemClass, "aria-label": customAriaLabel, ...restLink } = link;
    const fullHref = `/${lang}${href}`;
    // Check if the current route matches this link or the localized home root
    const isCurrent =
      normalize(currentPath) === normalize(fullHref) ||
      (href === "" && normalize(currentPath) === `/${lang}`);

    return (
      <Link
        href={fullHref}
        lang={lang}
        class:list={[className, itemClass]}
        title={title}
        aria-label={customAriaLabel || t("link_to", { title })}
        aria-current={isCurrent ? "page" : undefined}
        {...restLink}
      >
        {title}
      </Link>
    );
  })
}
