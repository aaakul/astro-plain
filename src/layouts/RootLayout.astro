---
import "@/styles/reset.css";
import "@/styles/global.css";
import Footer from "@/components/Footer.astro";
import Header from "@/components/header/Header.astro";
import { AVAILABLE_LANG, DEFAULT_LANG, getTranslations, type Lang } from "~/i18n";
import ScrollTop from "@/components/ScrollTop.astro";
import BaseHead from "@/components/BaseHead.astro";
import SiteConfig, { SITE_URL_WITH_BASE } from "~/site.config";
import { ClientRouter } from "astro:transitions";
import LoadingIndicator from "astro-loading-indicator/component";
import type { ImageMetadata } from "astro";

type Props = {
  lang: Lang;
  title?: string;
  description?: string;
  image?: string | ImageMetadata;
  canonicalURL?: string | null;
  alternates?: Map<Lang | "x-default", string> | null;
  noindex?: boolean;
  languageSwitchLinks?: Map<Lang, string>;
  type?: "article" | "website" | "profile";
  authors?: string[] | string;
  publishedTime?: string;
  modifiedTime?: string;
  username?: string;
};

const {
  lang,
  title: headTitle,
  description: headDescription,
  image,
  canonicalURL = Astro.url.href.replace(`/${lang}`, `/${DEFAULT_LANG}`),
  alternates,
  noindex = false,
  languageSwitchLinks,
  type = "website",
  authors,
  publishedTime,
  modifiedTime,
  username,
} = Astro.props;

const rawImage = image ?? SiteConfig.ogImage;
const imageSrc =
  typeof rawImage === "object" && rawImage !== null && "src" in rawImage ? rawImage.src : rawImage;

const ogImageUrl = imageSrc ? new URL(imageSrc, Astro.site ?? Astro.url).href : undefined;

const t = getTranslations(lang, "common");

const siteTitle = t("site_title");
const siteDescription = t("site_description");

const title = headTitle ? `${headTitle} | ${siteTitle}` : siteTitle;
const description = headDescription ?? siteDescription;

const alternateList: { language: Lang; href: string }[] = [];
let xDefaultURL: string | null = null;

// Build SEO hreflang tags for multilingual indexing (unless page is marked noindex)
if (!noindex) {
  if (typeof alternates === "undefined") {
    // Default: assume matching URLs exist across all languages
    AVAILABLE_LANG.forEach((language) => {
      alternateList.push({
        language,
        href: Astro.url.href.replace(`/${lang}`, `/${language}`),
      });
    });
    xDefaultURL = canonicalURL;
  } else if (alternates) {
    // Custom alternates map provided by page (e.g. blog posts with specific slugs per lang)
    alternates.forEach((href, language) => {
      if (language === "x-default") {
        xDefaultURL = href;
      } else {
        alternateList.push({ language, href });
      }
    });
    if (!xDefaultURL && canonicalURL) {
      xDefaultURL = canonicalURL;
    }
  }
}

// Language switch links for UI header dropdown (falls back to current path with language prefix swapped)
const switchLinks: Map<Lang, string> =
  languageSwitchLinks ??
  new Map(
    AVAILABLE_LANG.map((language) => [
      language,
      Astro.url.pathname.replace(`/${lang}`, `/${language}`),
    ]),
  );
---

<!doctype html>
<html
  lang={lang}
  data-code-theme-light={SiteConfig.codeTheme.light}
  data-code-theme-dark={SiteConfig.codeTheme.dark}
>
  <head>
    <BaseHead />
    <ClientRouter />
    <LoadingIndicator color="var(--primary)" height="0.25rem" />

    {/* Microsoft Clarity */}
    {
      import.meta.env.PROD && SiteConfig.clarity?.enable && SiteConfig.clarity?.projectId && (
        <script
          type="text/javascript"
          is:inline
          set:html={`
        (function (c, l, a, r, i, t, y) {
          c[a] =
            c[a] ||
            function () {
              (c[a].q = c[a].q || []).push(arguments);
            };
          t = l.createElement(r);
          t.async = 1;
          t.src = "https://www.clarity.ms/tag/" + i;
          y = l.getElementsByTagName(r)[0];
          y.parentNode.insertBefore(t, y);
        })(window, document, "clarity", "script", "${SiteConfig.clarity.projectId}");
      `}
        />
      )
    }

    {noindex && <meta name="robots" content="noindex,follow" />}

    {/* Primary Meta Tags */}
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />

    {/* Open Graph / Facebook */}
    <meta property="og:type" content={type} />
    <meta property="og:url" content={Astro.url} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:language" content={lang} />
    <meta property="og:site_name" content={t("site_title")} />
    {ogImageUrl && <meta property="og:image" content={ogImageUrl} />}
    {
      publishedTime && type === "article" && (
        <meta property="article:published_time" content={publishedTime} />
      )
    }
    {
      modifiedTime && type === "article" && (
        <meta property="article:modified_time" content={modifiedTime} />
      )
    }
    {
      type === "article" && typeof authors === "string" && (
        <meta property="article:author" content={authors} />
      )
    }
    {
      type === "article" &&
        Array.isArray(authors) &&
        authors.map((a) => <meta property="article:author" content={a} />)
    }
    {type === "profile" && username && <meta property="profile:username" content={username} />}

    {/* Twitter */}
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={Astro.url} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    {ogImageUrl && <meta property="twitter:image" content={ogImageUrl} />}

    <link
      rel="alternate"
      type="application/rss+xml"
      title="RSS"
      href={`${SITE_URL_WITH_BASE}/${lang}/rss.xml`}
    />

    {/* Canonical URL */}
    {!noindex && canonicalURL && <link rel="canonical" href={canonicalURL} />}

    {/* Alternate URL */}
    {
      !noindex &&
        alternateList.map(({ language, href }) => (
          <link rel="alternate" href={href} hreflang={language} />
        ))
    }
    {!noindex && xDefaultURL && <link rel="alternate" href={xDefaultURL} hreflang="x-default" />}
  </head>
  <body>
    <ScrollTop lang={lang} />
    <Header lang={lang} switchLinks={switchLinks} />
    <style>
      body {
        display: flex;
        flex-direction: column;
        min-height: 100vh;
        min-height: 100dvh;
      }

      #container {
        margin-inline: auto;

        padding: var(--space-4);

        flex: 1;

        width: 100%;
        max-width: var(--content-max-width);
        box-sizing: border-box;
      }

      #container:focus {
        outline: none;
      }

      @media screen and (min-width: 1024px) {
        #container {
          padding-inline: var(--space-8);
        }
      }
    </style>
    <div class="fadeIn" id="container" transition:animate="none">
      <div id="main-content" tabindex="-1"></div>
      <slot name="header" />
      <slot name="content" />
      <slot name="footer" />
    </div>
    <Footer lang={lang} />
  </body>
</html>
